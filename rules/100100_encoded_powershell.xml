<group name="sysmon,powershell,">
  <rule id="100100" level="10">
    <if_sid>92027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(enc|encodedcommand)\s</field>
    <description>Encoded PowerShell command executed</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>
</group>
